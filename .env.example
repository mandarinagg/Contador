# CONTADOR AI — variables de entorno del backend
# Copiar a backend/.env y completar. Nunca commitear el .env real.

# --- General ---
# development | test | production
CONTADOR_ENV=development
CONTADOR_LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL) ---
# En desarrollo la levanta docker-compose.yml en el puerto 55433.
CONTADOR_DATABASE_URL=postgresql+psycopg://contador:contador_dev@127.0.0.1:55433/contador
# Base que usan las pruebas (se crea sola si no existe).
CONTADOR_TEST_DATABASE_URL=postgresql+psycopg://contador:contador_dev@127.0.0.1:55433/contador_test

# --- Servidor API ---
# Solo escucha en la máquina local: es una aplicación de escritorio.
CONTADOR_API_HOST=127.0.0.1
CONTADOR_API_PORT=8765
# Orígenes que pueden llamar a la API (frontend de desarrollo y webview de Tauri).
CONTADOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

# --- Sesiones ---
CONTADOR_SESSION_TTL_HOURS=12
CONTADOR_SESSION_IDLE_MINUTES=60
CONTADOR_LOGIN_MAX_ATTEMPTS=5
CONTADOR_LOGIN_LOCKOUT_MINUTES=15

# --- Pendientes (fases futuras; no se usan todavía) ---
# Clave (32 bytes base64) para cifrar secretos en la base: certificados, CSC, tokens.
# Generar con: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# En la app de escritorio se guardará en el almacén seguro del sistema operativo.
# CONTADOR_SECRETS_KEY=
# Claude API (Fase 6). En escritorio irá al almacén seguro del SO, nunca al frontend.
# ANTHROPIC_API_KEY=
# Servicio SIFEN reutilizado de facturacion-sifen-zestia (Fase 5).
# CONTADOR_SIFEN_SERVICE_URL=http://127.0.0.1:8766
